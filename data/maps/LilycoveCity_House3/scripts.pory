mapscripts LilycoveCity_House3_MapScripts {

}

script LilycoveCity_House3_EventScript_Man {
    lockall
    faceplayer
    msgbox(format("It can be pretty tough to get around Triver, so we use our Pokemon to get fly."))
    if(!flag(FLAG_RECEIVED_HM_FLY)) {
        msgbox(format("Here why don't you to the HM"))
        giveitem(ITEM_HM_FLY)
    }
    releaseall
}

script LilycoveCity_House3_EventScript_PokefanF {
    lockall
    faceplayer
    msgbox(format("I'm working on a way to fly without using Pokemon, come back soon and I'll share it with you."))
    //todo fly without hm
    releaseall 
}