mapscripts BedrockTown_MapScripts {
    
}

script BedrockTown_TownSign {
    lockall
    msgbox(format("Bedrock Town:\nAn ancient lake now full of life."), MSGBOX_DEFAULT)
    releaseall
}

script BedrockTown_LabSign {
    lockall
    msgbox(format("Professor Holly's Lab.\nLeading the research into a lost past."), MSGBOX_DEFAULT)
    releaseall
}

script BedrockTown_EventScript_HollyAid {
    lockall
    msgbox(format("Sorry no one is allowed through without Professor Holly's permission."), MSGBOX_DEFAULT)
    releaseall
}

script COMINGSOON {
    lockall
    msgbox("COMING SOON")
    releaseall
}
