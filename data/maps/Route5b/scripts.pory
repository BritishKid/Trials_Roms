mapscripts Route5b_MapScripts {}


script Route5b_TrianerBattle_Bumbleboozer {
    trainerbattle_single(TRAINER_BUMBLE, BumbleBoozer_Intro, BumbleBoozer_Outro, Bumbleboozer_Postscript)
    msgbox(BumbleBoozer_PostBattle, MSGBOX_DEFAULT)
    end
}

script Bumbleboozer_Postscript {
    lockall
    msgbox(format("You can have this, I don't want it anymore."))
    giveitem(ITEM_HONEY, 5)
    releaseall
}


script Route5b_Pyukumuku_Clean_Up_1 {
    lock
    faceplayer
    msgbox(format("It's a Pyukumuku, you push it back into the water"))
    fadescreen(FADE_TO_BLACK)
    msgbox(format("SPLASH"))
    removeobject(3)
    setflag(FLAG_CLEANED_UP_PYUKUMUKU_1)
    fadescreen(FADE_FROM_BLACK)
    giveitem(ITEM_STICKY_BARB)
    msgbox(format("You found a big pearl under the Pokémon."))
    playfanfare(MUS_OBTAIN_ITEM)
    call(IncrementNumber_Pyukumukus_Saved)
    release
}

script Route5b_Pyukumuku_Clean_Up_2 {
    lock
    faceplayer
    msgbox(format("It's a Pyukumuku, you push it back into the water"))
    fadescreen(FADE_TO_BLACK)
    msgbox(format("SPLASH"))
    removeobject(4)
    setflag(FLAG_CLEANED_UP_PYUKUMUKU_2)
    fadescreen(FADE_FROM_BLACK)
    giveitem(ITEM_BIG_PEARL)
    msgbox(format("You found a big pearl under the Pokémon."))
    playfanfare(MUS_OBTAIN_ITEM)
    call(IncrementNumber_Pyukumukus_Saved)
    release
}

script IncrementNumber_Pyukumukus_Saved {
    addvar(VAR_PYUKUMUKUS_SAVED, 1)
}

script Route5b_WarningTrainer{
    trainerbattle_single(TRAINER_ROUTE5b_RACHEL, Route5b_Rachel_Intro, Route5b_Rachel_Outro)
    msgbox(Route5b_Rachel_Postbattle, MSGBOX_AUTOCLOSE)
}

//text
text BumbleBoozer_Intro {
    format("My victory will be sweet!")
}

text BumbleBoozer_Outro {
    format("Now I'm sour.")
}

text BumbleBoozer_PostBattle {
    format("...")
}


text Route5b_Rachel_Intro {
    format("I wouldn't go further east, some thugs have taken over the town and they are very strong. Not even Gym Leader Kevin could beat them.")
}

text Route5b_Rachel_Outro {
    format("You're strong, but I'm not sure you're strong enough.")
}

text Route5b_Rachel_Postbattle {
    format("You're welcome to try to beat them but without beating Hemlock Gym you won't stand a chance.")
}