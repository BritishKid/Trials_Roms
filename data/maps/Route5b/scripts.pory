mapscripts Route5b_MapScripts {}


script Route5b_TrianerBattle_Bumbleboozer {
    trainerbattle_single(TRAINER_BUMBLE, BumbleBoozer_Intro, BumbleBoozer_Outro, Bumbleboozer_Postscript)
    msgbox(BumbleBoozer_PostBattle, MSGBOX_DEFAULT)
    end
}

script Bumbleboozer_Postscript {
    lockall
    msgbox(format("You can have this, I don't want it anymore."))
    giveitem(ITEM_HONEY, 5)
    releaseall
}


script Route5b_Pyukumuku_Clean_Up_1 {
    lock
        msgbox(format("It's a Pyukumuku, you push it back into the water"))
        fadescreen(FADE_TO_BLACK)
        msgbox(format("SPLASH"))
        fadescreen(FADE_FROM_BLACK)
        removeobject(2)
        setflag(FLAG_CLEANED_UP_PYUKUMUKU_1)
        giveitem(ITEM_STICKY_BARB)
        msgbox(format("You found a big pearl under the Pokemon."))
        playfanfare(MUS_OBTAIN_ITEM)
        call(IncrementNumber_Pyukumukus_Saved)
    release
}

script Route5b_Pyukumuku_Clean_Up_2 {
    lock
        msgbox(format("It's a Pyukumuku, you push it back into the water"))
        fadescreen(FADE_TO_BLACK)
        msgbox(format("SPLASH"))
        fadescreen(FADE_FROM_BLACK)
        removeobject(3)
        setflag(FLAG_CLEANED_UP_PYUKUMUKU_2)
        giveitem(ITEM_BIG_PEARL)
        msgbox(format("You found a big pearl under the Pokemon."))
        playfanfare(MUS_OBTAIN_ITEM)
        call(IncrementNumber_Pyukumukus_Saved)
    release
}

script IncrementNumber_Pyukumukus_Saved {
    addvar(VAR_PYUKUMUKUS_SAVED, 1)
}

