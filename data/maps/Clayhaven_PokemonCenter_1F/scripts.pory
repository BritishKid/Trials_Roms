raw `.set LOCALID_NURSE, 1

Clayhaven_PokemonCenter_1F_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, Clayhaven_PokemonCenter_1F_OnTransition
	map_script MAP_SCRIPT_ON_RESUME, CableClub_OnResume
	.byte 0

Clayhaven_PokemonCenter_1F_OnTransition:
	setrespawn HEAL_LOCATION_CLAYHAVEN
	call Common_EventScript_UpdateBrineyLocation
	end

Clayhaven_PokemonCenter_1F_EventScript_Nurse::
	setvar VAR_0x800B, LOCALID_NURSE
	call Common_EventScript_PkmnCenterNurse
	waitmessage
	waitbuttonpress
	release
	end
`

script ClayHaven_PokemonCenter_Picknicker {
	lockall
	faceplayer
	msgbox(format("Triver is a unique region, it's the only one where the gyms aren't inside the towns and cities. It can make tiring having to go back to heal so make sure you stock up at the Mart."))
	releaseall
}

script ClayHaven_PokemonCenter_Camper {
	lockall
	faceplayer
	msgbox(format("Some trainers are much stronger than others, it's these guys in red that keep sending me back here to heal. Maybe I'll just avoid them next time."))
	releaseall
}
