//movement
movement Movement_Gym2_Robert_Approaches {
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
}

movement Movement_Gym2_RobertMoves {
    walk_right
    walk_right
    walk_up
    face_down
}

movement Movement_Gym2_RobertLeaves {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
}

movement Movement_Gym2_Robert_ExclamationMark {
    emote_exclamation_mark
}