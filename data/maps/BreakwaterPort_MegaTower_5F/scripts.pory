mapscripts BreakwaterPort_MegaTower_5F_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        setvar(VAR_MEGATOWER_STATE, 2)
    }
}

script BreakwaterPort_MegaTower_5F_Trigger_Right {
    lockall
    setvar(VAR_MEGATOWER_STATE, 3)
    msgbox(format("Well done for making it this fair but now it's time for you to experience to true power of Mega Evolution."), MSGBOX_AUTOCLOSE)
    applymovement(1, Movement_AceTrainer1_MoveToPosition)
    waitmovement(1)
    msgbox(format("I hope you're ready I'll be your first opponent."))
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerToStart_Right)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    goto(Megatower_5F_Battle1)
    releaseall
}

script BreakwaterPort_MegaTower_5F_Trigger_Left {
    lockall
    setvar(VAR_MEGATOWER_STATE, 3)
    msgbox(format("Well done for making it this fair but now it's time for you to experience to true power of Mega Evolution."), MSGBOX_AUTOCLOSE)
    applymovement(1, Movement_AceTrainer1_MoveToPosition)
    waitmovement(1)
    msgbox(format("I hope you're ready I'll be your first opponent."))
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerToStart_Left)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    goto(Megatower_5F_Battle1)
    releaseall
}

script Megatower_5F_Battle1 {
    trainerbattle_single(MEGATOWER5F_TRAINERACE1, Megatower5F_TrainerAce1_Intro, Megatower5F_TrainerAce1_Outro, Megatower5F_TrainerAce1_Beaten)
}

script Megatower5F_TrainerAce1_Beaten {
    applymovement(1, Movement_AceTrainer1_MoveOutTheWay)
    applymovement(2, Movement_AceTrainer2_MoveToPosition)
    waitmovement(2)
    trainerbattle_single(MEGATOWER5F_TRAINERACE2, Megatower5F_TrainerAce2_Intro, Megatower5F_TrainerAce2_Outro, Megatower5F_TrainerAce2_Beaten)
}

script Megatower5F_TrainerAce2_Beaten {
    applymovement(2, Movement_AceTrainer2_MoveOutTheWay)
    applymovement(3, Movement_AceTrainer3_MoveToPosition)
    waitmovement(3)
    trainerbattle_single(MEGATOWER5F_TRAINERACE3, Megatower5F_TrainerAce3_Intro, Megatower5F_TrainerAce3_Outro, Megatower5F_TrainerAce3_Beaten)
}

script Megatower5F_TrainerAce3_Beaten {
    applymovement(3, Movement_AceTrainer3_MoveOutTheWay)
    applymovement(4, Movement_AceTrainer4_MoveToPosition)
    waitmovement(4)
    trainerbattle_single(MEGATOWER5F_TRAINERACE4, Megatower5F_TrainerAce4_Intro, Megatower5F_TrainerAce4_Outro, Megatower5F_TrainerAce4_Beaten)
}

script Megatower5F_TrainerAce4_Beaten {
    msgbox(format("Well done but you still have one more battle to overcome."))
    clearflag(FLAG_HIDE_EXPERT_MEGATOWER)
    addobject(5)
    applymovement(4, Movement_AceTrainer4_MoveOutTheWay)
    applymovement(5, Movement_AceTrainer3_MoveToPosition) //can use same movement as they are in same position
    waitmovement(5)
    trainerbattle_single(MEGATOWER5F_TRAINEREXPERT, Megatower5F_TrainerExpert_Intro, Megatower5F_TrainerExpert_Outro, Megatower5F_TrainerExpert_Beaten)
}

script Megatower5F_TrainerExpert_Beaten {
    msgbox(format("Wow, you really are a special trainer."))
    special(DoDomeConfetti)
    if(flag(FLAG_MEGA_TOWER_BEATEN)) {//for repeat wins
        msgbox(format("Well done, you really have shown it was no mistake giving you that ring."), MSGBOX_AUTOCLOSE)
        addmoney(10000)
        //todo some else?
        //todo rewards for repeats
    }
    if(!flag(FLAG_MEGA_TOWER_BEATEN)) { //todo create a challenge mode this is for first time 
        msgbox(format("You've really shown your skill as a trainer and bond with your Pokemon. You really do deserve this reward."), MSGBOX_AUTOCLOSE)
        giveitem(ITEM_MEGA_RING)
        addmoney(10000)
        setflag(FLAG_MEGA_TOWER_BEATEN)
        msgbox(format("When you have this ring equipped you'll be able to mega evolve your Pokemon that's holding a mega stone."))
        msgbox(format("I'm sure with this new power you'll be a champion in no time."))
    }
    msgbox(format("Good luck with your journey I'm sure we will see you again."))
    //todo reward and stop player from leaving through south door
}

script MegaTower5F_Expert {
    lockall
    faceplayer
    msgbox(format("Good luck with your journey I'm sure we will see you again."))
    releaseall
}

script MegaTower5F_PostChat {
    //TODO make unique for them all
    lockall
    faceplayer
    msgbox(format("Wow you really are incredible."))
    releaseall
}

//text
text Megatower5F_TrainerAce1_Intro {
    format("What you've done so far was a warm up, this is the true challenge.")
}

text Megatower5F_TrainerAce1_Outro {
    format("I expected nothing less from you.")
}

text Megatower5F_TrainerAce2_Intro {
    format("Are you ready to feel the power of my true ace?")
}

text Megatower5F_TrainerAce2_Outro {
    format("You continue to surpass me.")
}

text Megatower5F_TrainerAce3_Intro {
    format("This will be where you challenge ends")
}

text Megatower5F_TrainerAce3_Outro {
    format("I mispoke.")
}

text Megatower5F_TrainerAce4_Intro {
    format("You're nearing the end, we never thought you would be this strong.")
}

text Megatower5F_TrainerAce4_Outro {
    format("One more to go.")
}

text Megatower5F_TrainerExpert_Intro {
    format("You've shown yourself to be incredibly strong but you have one last challenge to overcome.")
}

text Megatower5F_TrainerExpert_Outro {
    format("Well, I believe I should reward you.")
}

//movement 

movement Movement_PlayerToStart_Right {
    walk_up
    walk_up
    walk_up
    walk_left
    walk_left
    walk_left
    walk_left
    face_right
}

movement Movement_PlayerToStart_Left {
    walk_up
    walk_up
    walk_up
    walk_left
    walk_left
    walk_left
    walk_left
    face_right
}

movement Movement_AceTrainer1_MoveToPosition {
    walk_down
    walk_down
    walk_down
    walk_right
    walk_right
    walk_right
    walk_right
    walk_right
    face_left
}


movement Movement_AceTrainer2_MoveToPosition {
    walk_down
    walk_down
    walk_down
    walk_right
    walk_right
    walk_right
    walk_right
    face_left
}

movement Movement_AceTrainer3_MoveToPosition {
    walk_down
    walk_down
    walk_down
    walk_right
    walk_right
    walk_right
    face_left
}

movement Movement_AceTrainer4_MoveToPosition {
    walk_down
    walk_down
    walk_down
    walk_right
    walk_right
    face_left
}

movement Movement_AceTrainer1_MoveOutTheWay {
    walk_right
    walk_right
    walk_down
    walk_down
    face_left
}

movement Movement_AceTrainer2_MoveOutTheWay {
    walk_right
    walk_right
    walk_down
    face_left
}


movement Movement_AceTrainer3_MoveOutTheWay {
    walk_right
    walk_right
    walk_up
    walk_up
    face_left
}

movement Movement_AceTrainer4_MoveOutTheWay {
    walk_right
    walk_right
    walk_up
    face_left
}