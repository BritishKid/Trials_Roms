mapscripts Route5_MapScripts {}



script Route5_IslandBoat {
    lockall
    faceplayer
    msgbox(format("Would you like to travel to Island 1?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        warp(MAP_CORAL_PORT_HARBOR, 8, 11)
    }
    releaseall
}


script Route5_Sign_Directinos {
    lockall
    if(!flag(FLAG_HIDE_BLOCKER_THUGS)) {
        msgbox(format("Someone has scrawled over the sign to say:\lTHIS IS OUR ISLAND!"))
    }
    else {
        msgbox(format("-> TOWN TO BE NAMED\l<- Hemlock Village"))
    }
    releaseall
}

script Route5_Pyukumuku_Clean_Up {
    lock
    msgbox(format("It's a Pyukumuku, you push it back into the water"))
    fadescreen(FADE_TO_BLACK)
    msgbox(format("SPLASH"))
    removeobject(3)
    setflag(FLAG_CLEANED_UP_PYUKUMUKU_3)
    fadescreen(FADE_FROM_BLACK)
    giveitem(ITEM_BIG_PEARL)
    msgbox(format("You found a big pearl under the Pokémon."))
    playfanfare(MUS_OBTAIN_ITEM)
    call(IncrementNumber_Pyukumukus_Saved)
    release
}

script Route5_Trainerbattle_DogWalker {
    trainerbattle_single(ROUTE5_DOGWALKER, Route5_Dogwalker_Intro, Route5_Dogwalker_Outro, Increase_Trainers_Beaten)
    msgbox(Route5_Dogwalker_Postbattle, MSGBOX_AUTOCLOSE)
}

script Giant_Kingler {
    lockall
    // questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_GIANT_FISH)
    if(var(VAR_GIANT_FISH_STATE) == 1 && !flag(FLAG_GIANT_KINGLER_BEATEN)) {
        msgbox(format("You see a giant Pokémon scuttling under the surface, do you want to attempt to catch it?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            setflag(FLAG_CANT_CATCH_MON)
            // setflag(FLAG_CANNOT_RUN_FROM_BATTLE)
            msgbox(format("It leaps out at you"))
            settotemboost(1, 1, 1, 1, 0, 1, 0, 0)
            setwildbattle(SPECIES_KINGLER, 35, ITEM_SITRUS_BERRY) //todo buff moves make it tough
            dowildbattle()
            // subquestmenu(QUEST_MENU_COMPLETE_QUEST, QUEST_POKEMON_LEAGUE, SUB_QUEST_GIANT_FISH_2) //could not work?
            msgbox(format("The Kingler flees and leaves something behind"))
            giveitem(ITEM_GRIP_CLAW)
            setflag(FLAG_GIANT_KINGLER_BEATEN)
            addvar(VAR_GIANT_FISH_BEATEN, 1)
            clearflag(FLAG_CANT_CATCH_MON)
            // clearflag(FLAG_CANNOT_RUN_FROM_BATTLE)
        }
        else {
            end
        }
    }
    else {
        msgbox(format("You see a giant Pokémon scuttling under the surface"))
    }
    releaseall
}

