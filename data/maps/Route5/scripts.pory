mapscripts Route5_MapScripts {}



script Route5_IslandBoat {
    lockall
    faceplayer
    msgbox(format("Would you like to travel to Island 1?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        warp(MAP_CORAL_PORT_HARBOR, 8, 11)
    }
    releaseall
}


script Route5_Sign_Directinos {
    lockall
    if(!flag(FLAG_HIDE_BLOCKER_THUGS)) {
        msgbox(format("Someone has scrawled over the sign to say:\lTHIS IS OUR ISLAND!"))
    }
    else {
        msgbox(format("-> TOWN TO BE NAMED\l<- Hemlock Village"))
    }
    releaseall
}

script Route5_Pyukumuku_Clean_Up {
    lock
    msgbox(format("It's a Pyukumuku, you push it back into the water"))
    fadescreen(FADE_TO_BLACK)
    msgbox(format("SPLASH"))
    removeobject(3)
    setflag(FLAG_CLEANED_UP_PYUKUMUKU_3)
    fadescreen(FADE_FROM_BLACK)
    giveitem(ITEM_BIG_PEARL)
    msgbox(format("You found a big pearl under the Pokémon."))
    playfanfare(MUS_OBTAIN_ITEM)
    call(IncrementNumber_Pyukumukus_Saved)
    release
}

script Route5_Trainerbattle_DogWalker {
    trainerbattle_single(ROUTE5_DOGWALKER, Route5_Dogwalker_Intro, Route5_Dogwalker_Outro, Increase_Trainers_Beaten)
    msgbox(Route5_Dogwalker_Postbattle, MSGBOX_AUTOCLOSE)
}

//text

text Route5_Dogwalker_Intro {
    format("We love stretching our legs on this beach.")
}

text Route5_Dogwalker_Outro {
    format("Exercise will make the pain of the loss go away.")
}

text Route5_Dogwalker_Postbattle {
    format("We should head back the suns heading down.")
}