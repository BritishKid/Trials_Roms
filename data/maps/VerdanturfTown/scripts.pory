raw `VerdanturfTown_MapScripts::
	map_script MAP_SCRIPT_ON_TRANSITION, VerdanturfTown_OnTransition
	.byte 0

VerdanturfTown_OnTransition:
	setflag FLAG_VISITED_VERDANTURF_TOWN
	end
`

script VerdanturfTown_EventScript_DayCareSign {
    lockall
    msgbox(format("Pokemon Day Care:\lLet use look after your little friends!"))
    releaseall
}

script VerdanturfTown_EventScript_TownSign {
    lockall
    msgbox(format("TODO NAME TOWN:\lWORDS BUT YES"))
    releaseall
}