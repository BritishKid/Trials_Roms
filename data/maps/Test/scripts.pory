mapscripts Test_MapScripts {}

script LittlerootTown_ProfessorBirchsLab_EventScript_CharmanderSelection {
    lockall
    if(!flag(FLAG_LEFTOVERS_ORPHANAGE)){
        showmonpic(SPECIES_CHARMANDER, 10, 3)
        msgbox(format("Do you want to select Charmander?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO) {
            msgbox(format("I'll choose another Pokémon"))
        }
        if(var(VAR_RESULT) == YES) {
            givemon(SPECIES_CHARMANDER, 5, ITEM_ORAN_BERRY)
            playfanfare(MUS_OBTAIN_ITEM)
            setflag(FLAG_RECEIVED_CHARMANDER)
            removeobject(8)
            setflag(FLAG_LEFTOVERS_ORPHANAGE)
            setvar(VAR_STARTER_SELECTION_STATE, 2)
        }
        hidemonpic
    }
    releaseall
}

