mapscripts Route1b_MapScripts {
    
}

script Route1b_EventScript_FisherSign {
    lockall
    msgbox(format("The Old Fisher's House"), MSGBOX_DEFAULT)
    releaseall
}

script Route1b_EventScript_Fisherman {
    lockall
    faceplayer
    msgbox(format("If only I had a Pokémon that knew SURF, I'd be able to reach that island."))
    releaseall
}

script Route1b_BattleSalt7_FirstBattle {
    trainerbattle_single(TRAINER_SALT7_ROUTE_1B_ENCOUNTER, Salt7_Intro, Salt7_Outro, Salt7_PostBattleScript)
    msgbox(PostBattle_Salt7, MSGBOX_AUTOCLOSE)
    end
}

script Salt7_PostBattleScript {
    setflag(FLAG_SALT7_BEATEN_FIRST_ENCOUNTER)
    // questmenu(QUEST_MENU_SET_ACTIVE, QUEST_SALT7_GYRADOS)
    // subquestmenu(QUEST_MENU_COMPLETE_QUEST, QUEST_POKEMON_LEAGUE, SUB_QUEST_MET_SALT)
    setvar(VAR_SALTS7_QUEST_STATE, 1)
    waitmessage
}

script Route1_TrainerScript_Camper {
    trainerbattle_single(TRAINER_CAMPER_ROUTE1B, Route1b_Camper_Intro, Route1b_Camper_Outro, Increase_Trainers_Beaten)
        msgbox(Route1b_Camper_Postbattle, MSGBOX_AUTOCLOSE)

}

script Route1_TrainerScript_BugCatcher {
    trainerbattle_single(TRAINER_BUGCATCHER_ROUTE1B, Route1b_Bugcatcher_Intro, Route1b_Bugcatcher_Outro, Increase_Trainers_Beaten)
        msgbox(Route1b_Bugcatcher_Postbattle, MSGBOX_AUTOCLOSE)

}

//text scripts

text Salt7_Intro {
    format("The guy in that house there gave me an old rod! I'm going to use it to catch all the Gyarados I can find! I already caught some. Here, let me show you.")
}

text Salt7_Outro {
    format("Alright so they aren't Gyrados yes, but I'll get more and become unstoppable! But just how do I evolve them.")
}

text PostBattle_Salt7 {
    format("I remember reading something about a waterfall could make them evolve. I think there is one somewhere nearby")
}

text Route1b_Camper_Intro {
    format("My dad used to bring me here all the time; he said the hills had strong Pokémon.")
}

text Route1b_Camper_Outro {
    format("We never found them but I enjoyed our trips.")
}

text Route1b_Camper_Postbattle {
    format("When I'm strong enough I'll be able to spread his ashes at the old winged city.")
}

text Route1b_Bugcatcher_Intro {
    format("I love all the different bug Pokémon in Triver.")
}

text Route1b_Bugcatcher_Outro {
    format("I heard some really strong bugs can be found deep in the desert.")
}

text Route1b_Bugcatcher_Postbattle {
    format("People used to worship bugs as strong as the sun.")
}