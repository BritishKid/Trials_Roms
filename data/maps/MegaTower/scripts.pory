mapscripts MegaTower_MapScripts {}


script MegaTower_Sign {
    lockall
    msgbox(format("Only those who prove their strength may wield the power of Mega Evolution."))
    releaseall
}

script MegaTower_Trigger_1 {
    lockall
    setvar(VAR_PLAYER_LOCATION, 1)
    releaseall
}

script MegaTower_Trigger_2 {
    lockall
    setvar(VAR_PLAYER_LOCATION, 2)
    releaseall
}

script MegaTower_Trigger_3 {
    lockall
    setvar(VAR_PLAYER_LOCATION, 3)
    releaseall
}

script MegaTower_RivalFight {
    lockall
    clearflag(FLAG_HIDE_MEGATOWER_RIVAL)
    addobject(1)
    applymovement(1, Movement_MegaTower_RivalArrives)
    waitmovement(1)
    msgbox(format("You finally made it then, as always you're already behind."))
    msgbox(format("No need to say anything I recognise that look of awe you have looking at me especially now I have my Mega Ring."))
    msgbox(format("Stunned to silence I see."))
    //todo improve rival fight
    trainerbattle_single(MEGATOWER_RIVAL, MegaTower_Rival_Intro, MegaTower_Rival_Outro, MegaTower_Rival_PostBattle)
    releaseall
}

script MegaTower_Rival_PostBattle {
    msgbox(format("Well I have to give you a chance, not everyone can get their own Mega Ring."))
    msgbox(format("Any way I'm going to get the ferry to grab my next badge, I'm sure by the time you'll see me next I'll already be a champion."))
    msgbox(format("So long nerd!"))
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_MegaTower_MovePlayerRight)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    if(var(VAR_PLAYER_LOCATION) >= 2) {
        applymovement(OBJ_EVENT_ID_PLAYER, Movement_MegaTower_MovePlayerRight)
        waitmovement(OBJ_EVENT_ID_PLAYER)
    }
    if(var(VAR_PLAYER_LOCATION) >= 3) {
        applymovement(OBJ_EVENT_ID_PLAYER, Movement_MegaTower_MovePlayerRight)
        waitmovement(OBJ_EVENT_ID_PLAYER)
    }
    applymovement(1, Movement_MegaTower_RivalLeaves)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_MegaTower_FollowRivalDirection)
    waitmovement(1)
    setflag(FLAG_HIDE_MEGATOWER_RIVAL)
    removeobject(1)
    setvar(VAR_MEGATOWER_STATE, 1)
    releaseall
}

//text

text MegaTower_Rival_Intro {
    format("Let me show you the power of my new ring.")
}

text MegaTower_Rival_Outro {
    format("You keep getting lucky...")
}

//movement

movement Movement_MegaTower_RivalArrives {
    emote_exclamation_mark
    walk_down
    walk_down
}

movement Movement_MegaTower_MovePlayerRight {
    walk_right
}

movement Movement_MegaTower_FollowRivalDirection {
    face_left
    face_down
}

movement Movement_MegaTower_RivalLeaves {
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
}