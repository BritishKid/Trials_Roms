mapscripts CoralBeach_2_MapScripts {}


script CoralBeach2_Pyukumuku_Clean_Up {
    lock
        msgbox(format("It's a Pyukumuku, you push it back into the water"))
        fadescreen(FADE_TO_BLACK)
        msgbox(format("SPLASH"))
        removeobject(1)
        setflag(FLAG_CLEANED_UP_PYUKUMUKU_5)
        fadescreen(FADE_FROM_BLACK)
        giveitem(ITEM_BIG_PEARL)
        msgbox(format("You found a big pearl under the Pokémon."))
        playfanfare(MUS_OBTAIN_ITEM)
        call(IncrementNumber_Pyukumukus_Saved)
    release
}



script Giant_Gorebyss {
    lockall
    // questmenu(QUEST_MENU_CHECK_ACTIVE, QUEST_GIANT_FISH)
    if(var(VAR_GIANT_FISH_STATE) == 1 && !flag(FLAG_GIANT_GOREBYSS_BEATEN)) {
        msgbox(format("You see a giant Pokémon swimming under the surface, do you want to attempt to catch it?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            setflag(FLAG_CANT_CATCH_MON)
            // setflag(FLAG_CANNOT_RUN_FROM_BATTLE)
            msgbox(format("It leaps out at you"))
            settotemboost(1, 1, 1, 1, 0, 1, 0, 0)
            setwildbattle(SPECIES_GOREBYSS, 35, ITEM_DEEP_SEA_SCALE)
            dowildbattle()
            // subquestmenu(QUEST_MENU_COMPLETE_QUEST, QUEST_POKEMON_LEAGUE, SUB_QUEST_GIANT_FISH_2) //could not work?
            msgbox(format("The Gorebyss flees and leaves something behind"))
            giveitem(ITEM_DEEP_SEA_SCALE)
            setflag(FLAG_GIANT_GOREBYSS_BEATEN)
            addvar(VAR_GIANT_FISH_BEATEN, 1)
            clearflag(FLAG_CANT_CATCH_MON)
            // clearflag(FLAG_CANNOT_RUN_FROM_BATTLE)
        }
        else {
            end
        }
    }
    else {
        msgbox(format("You see a giant Pokémon swimming under the surface"))
    }
    releaseall
}
