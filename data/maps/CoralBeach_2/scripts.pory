mapscripts CoralBeach_2_MapScripts {}


script CoralBeach2_Pyukumuku_Clean_Up {
    lock
        msgbox(format("It's a Pyukumuku, you push it back into the water"))
        fadescreen(FADE_TO_BLACK)
        msgbox(format("SPLASH"))
        removeobject(1)
        setflag(FLAG_CLEANED_UP_PYUKUMUKU_5)
        fadescreen(FADE_FROM_BLACK)
        giveitem(ITEM_BIG_PEARL)
        msgbox(format("You found a big pearl under the Pokémon."))
        playfanfare(MUS_OBTAIN_ITEM)
        call(IncrementNumber_Pyukumukus_Saved)
    release
}