script GranitePeakTown_School_EventScript_EnterRight {
    lockall
    msgbox(format("So many amazing trainers came from this school, just look at all the names that have won the school Pokémon tournament."))
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_GranitePeakSchool_MovePlayerLeftOnce)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    call(GranitePeakSchool_Mat_TrophyCase)
    releaseall
}

script GranitePeakTown_School_EventScript_EnterLeft {
    lockall
    msgbox(format("So many amazing trainers came from this school, just look at all the names that have won the school Pokémon tournament."))
    call(GranitePeakSchool_Mat_TrophyCase)
    releaseall
}

script GranitePeakSchool_Mat_TrophyCase {
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_GranitePeakSchool_MovePlayerToMat)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(1, Movement_GranitePeakSchool_MatFaceDown)
    waitmovement(1)
    msgbox(format("One day my name will be on there!"))
    msgbox(format("Hi, I'm Mat and I'm going to be the very best!"))
    applymovement(1, Movement_GranitePeakSchool_MatExclamation)
    waitmovement(1)
    msgbox(format("Oh you're a trainer. Let me show you how good the future school champion is!"))
    trainerbattle_single(TRAINERSCHOOLHALL_MAT1, SchoolHall_Mat_Intro, SchoolHall_Mat_Outro, SchoolHall_Mat_Beaten)
}

script SchoolHall_Mat_Beaten {
    msgbox(format("I still have a lot to learn a but this school is the best place for me to be."))
    msgbox(format("If I complete all four classes and get their patches I can take part and win the school tournament."))
    msgbox(format("Let's get going!"))
    applymovement(1, Movement_GranitePeakSchool_MatMovesRooms)
    waitmovement(1)
    // playse() player sound for doorway
    removeobject(1)
    setflag(FLAG_HIDE_MAT_SCHOOL_HALL)
    setflag(FLAG_HIDE_MOVES_ROOM)
    setvar(VAR_MAT_STATE, 1)
    clearflag(FLAG_HIDE_MAT_MEGA_MANSION)
    //todo add quest checker
    call(Increase_Trainers_Beaten)
}

script GranitePeakTown_School_TrophyCase {
    lockall
    msgbox(format("It's the Granite Peak School Trainer Trophy."))
    msgbox(format("It's got all the previous winners etched into it..."))
    msgbox(format("Jordan"))
    //check if the player has won the tournament their name can go on aswell
    releaseall
}

script GranitePeakTown_School_MatLostID {
    lockall
    if(flag(FLAG_MAT_ID)){
        msgbox(format("It's empty"))
    }
    if(!flag(FLAG_MAT_ID)) {
        msgbox(format("You find someones student ID in the pot:\nIt belongs to Mat"))
        setflag(FLAG_MAT_ID)
    }
    releaseall
}

//Tournament Code

//SETUP
script GranitePeakTown_SchoolTournament_Teacher {
    lockall
    faceplayer
    if(!flag(FLAG_CAN_ACCESS_SCHOOL_TOURNAMENT)) { //check each patch once then if they can enter this is skipped
        msgbox(format("If you wish to take part in the tournament you must have first completed every class."))
        checkitem(ITEM_EVOLUTION_PATCH, 1)
        if(var(VAR_RESULT) == FALSE) {
            msgbox(format("You still need to complete the Evolution test."))
            releaseall
            end
        }
        msgbox(format("Good job on passing the Evolution test."))
        checkitem(ITEM_MOVES_PATCH, 1)
        if(var(VAR_RESULT) == FALSE) {
            msgbox(format("You still need to complete the Moves test."))
            releaseall
            end
        }
        msgbox(format("Brilliant you have completed the Moves test"))
        checkitem(ITEM_ITEMS_PATCH, 1)
        if(var(VAR_RESULT) == FALSE) {
            msgbox(format("You still need to complete the Items test."))
            releaseall
            end
        }
        msgbox(format("Great, you also completed the Items test"))
        checkitem(ITEM_ABILITIES_PATCH, 1)
        if(var(VAR_RESULT) == FALSE) {
            msgbox(format("You still need to complete the Abiliy test."))
            releaseall
            end
        }
        msgbox(format("Evolution test as well, fantastic job!"))
        setflag(FLAG_CAN_ACCESS_SCHOOL_TOURNAMENT)
    }
    if(flag(FLAG_CAN_ACCESS_SCHOOL_TOURNAMENT)) {
        msgbox(format("It looks like you can take part, would you like to?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == NO) {
            msgbox(format("Come back when you wish to give it a go."))
        }
        if(var(VAR_RESULT) == YES) {
            getpartysize
            if(var(VAR_RESULT) <= DOME_BATTLE_PARTY_SIZE) {
                //check player has 3 or less pokemon
                setvar(VAR_FRONTIER_FACILITY, FRONTIER_FACILITY_DOME) // We are going to hack the dome and add custom trainers into it
                setvar(VAR_FRONTIER_BATTLE_MODE, FRONTIER_MODE_SINGLES)
                goto(GranitePeakTown_BattleDomeLobby_EventScript_AttendantWelcome)
            }
            else {
                msgbox(format("Sorry you can't enter with more than 3 Pokémon."))
            }
        }
    }
    releaseall
}

script GranitePeakTown_BattleDomeLobby_EventScript_AttendantWelcome {
    //set level of the tournament based on badges aquired
    if(!flag(FLAG_BADGE02_GET)) {
        setvar(VAR_SCHOOL_TOURNAMENT_LEVEL, 22)
    } elif(!flag(FLAG_BADGE03_GET)) {
        setvar(VAR_SCHOOL_TOURNAMENT_LEVEL, 28)
    } elif(!flag(FLAG_BADGE04_GET)) {
        setvar(VAR_SCHOOL_TOURNAMENT_LEVEL, 35)
    } elif(!flag(FLAG_BADGE05_GET)) {
        setvar(VAR_SCHOOL_TOURNAMENT_LEVEL, 40)
    } else {
        setvar(VAR_SCHOOL_TOURNAMENT_LEVEL, 50)
    }

    setvar(VAR_0x8004, FRONTIER_UTIL_FUNC_SET_DATA)
    setvar(VAR_0x8005, FRONTIER_DATA_LVL_MODE)
    setvar(VAR_0x8006, FRONTIER_LVL_50) //forces to use the above level cap
    special(CallFrontierUtilFunc) //set everything up
    call(GranitePeakTown_SchoolTournamentLobby_EventScript_SaveBeforeChallenge)
}

script GranitePeakTown_SchoolTournamentLobby_EventScript_SaveBeforeChallenge {
    setvar(VAR_TEMP_0, 0)
    setvar(VAR_0x8004, BATTLE_DOME_FUNC_INIT)
    special(CallBattleDomeFunction)
    closemessage
    delay(2)
    setvar(VAR_TEMP_0, 255)
    setvar(VAR_0x8004, BATTLE_DOME_FUNC_INIT_TRAINERS) // sets up the trainers
    special(CallBattleDomeFunction)
    call(GranitePeakTown_SchoolTournament_EventScript_EnterChallenge)
}

script GranitePeakTown_SchoolTournament_EventScript_EnterChallenge {
    setvar(VAR_0x8004, BATTLE_DOME_FUNC_SET_TRAINERS)
    special(CallBattleDomeFunction)
    warp(MAP_GRANITE_PEAK_TOWN_TOURNAMENT_WAITING_ROOM, 6, 8)
    setvar(VAR_TEMP_0, 0)
    waitstate
    end
}

//Winning the Tournament

script GranitePeak_BattleDomeLobby_EventScript_BeatChallenge {
    lockall
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
    setvar(VAR_CURRENT_SCHOOL_TOURNAMENT_STATE, 0) //reset to allow for it to be repeatable
    msgbox(format("Congratulations you managed to beat the others! It was incredible to watch!"))
    setvar(VAR_SCHOOL_TEAM_RESET, 0)
    if(flag(FLAG_TRAINER_TOURNAMENT_WON)) { //Different prizes for repeated wins
        //scaled based on difficulty/badges earnt
        if(!flag(FLAG_BADGE02_GET)) {
            addmoney(5000)
        } elif(!flag(FLAG_BADGE03_GET)) {
            addmoney(6000)
        } elif(!flag(FLAG_BADGE04_GET)) {
            addmoney(7000)
        } elif(!flag(FLAG_BADGE05_GET)) {
            addmoney(8000)
        } else {
            addmoney(10000)
        }
        call(GranitePeakTown_SchoolTournament_MintPrizeSelection)
        } 
        //todo a bonus for multiple wins back to back? Maybe
        //below on runs for first time the player wins 
        if(!flag(FLAG_TRAINER_TOURNAMENT_WON)) {
            setflag(FLAG_TRAINER_TOURNAMENT_WON)
            msgbox(format("For your succes in the tournament take this trophy!"))
            givedecoration(DECOR_SILVER_SHIELD)
            // sub quest
            // quest menu when added
            addmoney(7500)
            call(GranitePeakTown_SchoolTournament_MintPrizeSelection)
        }
    releaseall
}

script GranitePeakTown_SchoolTournament_MintPrizeSelection {
    msgbox("Select your prize!")
    waitmessage()
    multichoice(21,6, MULTI_NATURE_MINT_SELECTION, TRUE)
    switch(var(VAR_RESULT)) {
        case 0: giveitem(ITEM_ADAMANT_MINT)
        case 1: giveitem(ITEM_MODEST_MINT)
        case 2: giveitem(ITEM_BOLD_MINT)
        case 3: giveitem(ITEM_CALM_MINT)
        case 4: giveitem(ITEM_JOLLY_MINT)
        case 5: giveitem(ITEM_TIMID_MINT)
    }
}

// Losing the Tournament
script  GranitePeak_BattleDomeLobby_EventScript_LostChallenge {
    lockall
    setvar(VAR_SCHOOL_TEAM_RESET, 0)
    turnobject(OBJ_EVENT_ID_PLAYER, DIR_NORTH)
    msgbox(format("Nice try, better luck next time."))
    setvar(VAR_0x8004, FRONTIER_UTIL_FUNC_SET_PARTY_ORDER)
    setvar(VAR_0x8005, FRONTIER_PARTY_SIZE)
    special(CallFrontierUtilFunc)
    frontier_checkairshow
    special(HealPlayerParty)
    releaseall
}

//movement
movement Movement_GranitePeakSchool_MovePlayerLeftOnce {
    walk_left
}

movement Movement_GranitePeakSchool_MovePlayerToMat {
    walk_up
}

movement Movement_GranitePeakSchool_MatFaceDown {
    face_down
}

movement Movement_GranitePeakSchool_MatExclamation {
    emote_exclamation_mark
}

movement Movement_GranitePeakSchool_MatMovesRooms {
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    face_up
}

