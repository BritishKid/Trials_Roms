mapscripts GranitePeakTown_SchoolHall_MapScripts {
    MAP_SCRIPT_ON_FRAME_TABLE [
        VAR_CURRENT_SCHOOL_TOURNAMENT_STATE, 1: GranitePeak_BattleDomeLobby_EventScript_BeatChallenge //this runs when the player wins and returns
        VAR_SCHOOL_TEAM_RESET, 5: GranitePeak_BattleDomeLobby_EventScript_LostChallenge //when the player loses this runs
    ]
}

