mapscripts GranitePeakTown_House3_MapScripts {}


script GranitePeakTown_House3_Trader {
    lockall
    faceplayer
    if(flag(FLAG_GRANITEPEAK_TRADE_COMPLETED)) {
        goto(GranitePeakTown_TradeCompleted)
    }
    setvar(VAR_0x8008, INGAME_TRADE_MAGNEMITE)
    copyvar(VAR_0x8004, VAR_0x8008)
    specialvar(VAR_RESULT, GetInGameTradeSpeciesInfo)
    copyvar(VAR_0x8009, VAR_RESULT)
    msgbox(format("The Pokémon on this Island are so different than my old home but I don't get much time to go out and catch them."))
    msgbox(format("If you had a {STR_VAR_1} I would love to trade it for my {STR_VAR_2}!"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO) {
        goto(GranitePeak_TradeDeclined)
    }
    if(var(VAR_RESULT) == YES) {
        special(ChoosePartyMon)
        waitstate
        copyvar(VAR_0x800A, VAR_0x8004)
        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
            goto(GranitePeak_TradeDeclined)
        }
        copyvar(VAR_0x8005, VAR_0x800A)
        specialvar(VAR_RESULT, GetTradeSpecies)
        copyvar(VAR_0x800B, VAR_RESULT)
        if(var(VAR_RESULT) != VAR_0x8009) {
            msgbox(format("That's a wierd looking {STR_VAR_1}"))
            end
        }
        copyvar(VAR_0x8004, VAR_0x8008)
        copyvar(VAR_0x8005, VAR_0x800A)
        special(CreateInGameTradePokemon)
        special(DoInGameTradeScene)
        waitstate
        msgbox(format("Thank you! I will take good care of Marill, make sure you look after AMPERE."))
        setflag(FLAG_GRANITEPEAK_TRADE_COMPLETED)
    }
    releaseall
}

script GranitePeak_TradeDeclined {
    msgbox(format("Oh that's a shame."))
    releaseall
}

script GranitePeakTown_TradeCompleted {
    msgbox(format("Your Marill is doing well!"))
    releaseall
}