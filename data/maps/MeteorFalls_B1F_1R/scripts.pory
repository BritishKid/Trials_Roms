//movement

movement Movement_LostLake_Surprise {
    face_down
    emote_exclamation_mark
}

movement Movement_LostLake_GoodraComing {
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
}

movement Movement_ProffessorAndAideToPlayer_LostLake2 {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
}

movement Movement_PlayerFacesUp {
    face_up
}

movement Movement_PlayerMovesOutTheWay {
    walk_left
    face_down
}

movement Movement_ProfessorRunsToArea3_LostLake {
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
}