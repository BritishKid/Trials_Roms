mapscripts Hemlock_Gym_Interior_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(!flag(FLAG_BADGE03_GET) && flag(FLAG_LEVEL_CAPS_ON)) {
            setflag(FLAG_TURN_ON_INCREASED_XP)
        }
    }
}

script HemlockGym_Interior_Greeter {
    lockall
    faceplayer
    msgbox(format("Yo Champ in the making! This gym specialises in Poison types. Psychic and Ground moves are the best way to take them out."))
    msgbox(format("Let me heal up your Pokémon before you go further."))
    special(HealPlayerParty)
    if(flag(FLAG_LEVEL_CAPS_ON) && !flag(FLAG_BADGE03_GET)) {
        msgbox(format("How about a battle for some fast levels?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            cleartrainerflag(GYM_XP_DUMP)
            trainerbattle_no_intro(GYM_XP_DUMP, GymXpDump_Outro)
        }
     }
    releaseall
}

script HemlockGym_Interior_Leader_Kevin {
    lockall
    trainerbattle_single(TRAINER_KEVIN_GYMLEADER, HemlockGym_Kevin_Intro, HemlockGym_Kevin_Outro, HemlockGym_KevinPostScript)
    msgbox(HemlockGym_Kevin_Postbattle, MSGBOX_AUTOCLOSE)
    releaseall
}

script HemlockGym_KevinPostScript {
    msgbox(format("That was unexpected! You should come down to the orphanage and teach them some of your skills."))
    playfanfare(MUS_OBTAIN_BADGE)
    msgbox(format("You obtained the Hemlock Badge."))
    special(DoDomeConfetti)
    setflag(FLAG_BADGE03_GET)
    clearflag(FLAG_TURN_ON_INCREASED_XP)
    msgbox(format("Also please take this TM, it contains the move Sludge Bomb."))
    giveitem(ITEM_TM36)
    releaseall
}

script Hemlock_TrainerBattle_Tessa {
    trainerbattle_single(HEMLOCKGYM_TRAINER_TESSA, HemlockGym_Tessa_Intro, HemlockGym_Tessa_Outro, Increase_Trainers_Beaten)
    msgbox(HemlockGym_Tessa_Postbattle, MSGBOX_AUTOCLOSE)
    end
}

