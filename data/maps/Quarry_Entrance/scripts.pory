mapscripts Quarry_Entrance_MapScripts {}


script Quarry_Entrance_Trigger_StartQuest {
    lockall
    applymovement(1, Movement_QuarryForeman_On_Entry)
    waitmovement(1)
    msgbox(format("You shouldn't be in here! I've had to shut down the operation of the quarry as some dangerous giant Pokemon have started running rampant"), MSGBOX_AUTOCLOSE)
    msgbox(format("I suggest you trun aroudn and get out of here, but from the look of you I doubt you're going to listen."), MSGBOX_AUTOCLOSE)
    msgbox(format("I guess if you are going to be crazy enough to go in you could alteast keep an eye out for anyone stuck. A few of my men haven't been able to escape."), MSGBOX_AUTOCLOSE)
    playmoncry(SPECIES_STEELIX, CRY_MODE_ENCOUNTER)
    applymovement(1, Movement_QuarryForeman_Scared)
    waitmovement(1)
    msgbox(format("I'm getting out of here!"), MSGBOX_AUTOCLOSE)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_Quarry_Player_Moves)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(1, Movement_QuarryForeman_Leaves)
    waitmovement(1)
    setvar(VAR_QUARRY_STATE, 1)
    setflag(FLAG_HIDE_QUARRY_FOREMAN_IN_QUARRY)
    //todo remove in version 1 its only here for people using old saves
    setflag(FLAG_HIDE_QUARRY_WORKERS)
    removeobject(1)
    releaseall
}

//movement
movement Movement_QuarryForeman_On_Entry {
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    emote_question_mark
}

movement Movement_QuarryForeman_Scared {
    emote_exclamation_mark
    jump_in_place_up
}

movement Movement_Quarry_Player_Moves {
    walk_left
    face_right
}

movement Movement_QuarryForeman_Leaves {
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_down
}