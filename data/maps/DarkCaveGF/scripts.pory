mapscripts DarkCaveGF_MapScripts {}


script DarkCaveGF_Battle_LostYoungster {
    trainerbattle_single(DARKCAVE_YOUNGSTER, DarkCave_Youngster_Intro, DarkCave_Youngster_Outro, Increase_Trainers_Beaten)
    msgbox(DarkCave_Youngster_PostBattle, MSGBOX_AUTOCLOSE)
}

script DarkCaveGF_Battle_LostThug {
    trainerbattle_single(DARKCAVE_THUG, DarkCave_Thug_Intro, DarkCave_Thug_Outro, Increase_Trainers_Beaten)
    msgbox(DarkCave_Thug_PostBattle, MSGBOX_AUTOCLOSE)
}


//intro 

text DarkCave_Youngster_Intro {
    format("HOW DO I GET OUT OF HERE!")
}

text DarkCave_Youngster_Outro {
    format("I can't find the exit...")
}

text DarkCave_Youngster_PostBattle {
    format("Oh I'm not that far, that's good.")
}

text DarkCave_Thug_Intro {
    format("How did you get past the rest of us?")
}

text DarkCave_Thug_Outro {
    format("I guess you really did beat them all.")
}

text DarkCave_Thug_PostBattle {
    format("They've just abandoned me in this cave.")
}