    format("I keep trying but failing to beat the gym.")
}

text MahoganyHills1_Bao_Outro {
    format("You might have a chance.")
}

text MahoganyHills1_Bao_Postbattle {
    format("I should probably catch some other Pokémon.")
}

text MahoganyHills1_ToughTrainer_Intro {
    format("I learnt so many battle strategies at school.")
}

text MahoganyHills1_ToughTrainer_Outro {
    format("Wow. You must be top of your class!")
}

text MahoganyHills1_ToughTrainer_Postbattle {
    format("Wait you've never been to school in GRANITE PEAK?")
}

//movement scripts
movement Movement_Child_Being_Chased {
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
    walk_fast_up
}

movement Movement_Child_Hidding_Behind_Player_Right {
    walk_fast_left
    walk_fast_up
    walk_fast_up
    walk_fast_right
    face_down
}
movement Movement_Child_Hidding_Behind_Player_Left {
    walk_fast_up
    walk_fast_up
    walk_fast_left
    face_down
}

movement Movement_MahoganyHills_ExclamationMark {
    emote_exclamation_mark
}

movement Movement_ZoruaChase4_MahoganyHills {
    walk_down
    walk_right
    walk_right
    walk_right
    walk_right
    walk_right
    walk_up
    walk_up
    walk_up
}