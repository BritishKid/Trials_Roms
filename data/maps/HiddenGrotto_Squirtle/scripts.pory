mapscripts HiddenGrotto_Squirtle_MapScripts {}

script HiddenGrotto_Squirtle_MegaStone_EventScript {
    lockall
    if(!flag(FLAG_BLASTOISE_MEGASTONE_FOUND)) {
        msgbox(format("There seems to be a blue marble like object on the altar."))
        playmoncry(SPECIES_BLASTOISE, CRY_MODE_ENCOUNTER)
        applymovement(OBJ_EVENT_ID_PLAYER, Movement_MegaStoneGrotto_PlayerSurpised)
        waitmovement(OBJ_EVENT_ID_PLAYER)
        clearflag(FLAG_HIDDEN_MEGA) //todo custom mega sprite for overworld current is placeholder
        addobject(2)
        applymovement(2, Movement_BlastoiseArrives)
        waitmovement(2)
        msgbox(format("BLAST! BLASTOISE!"))
        call(MegaBlastoiseBattle)
        call(MegaBlastoiseBeaten)
    } else {
        msgbox(format("There is an indent from where I found the Blastoisinite"))
    }
}

script MegaBlastoiseBattle {
    settotemboost(1, 0, 2, 0, 1, 2, 0, 0)
    setflag(FLAG_CANT_CATCH_MON)
    setwildbattle(SPECIES_BLASTOISE_MEGA, 45, ITEM_BLASTOISINITE)
    dowildbattle
}

script MegaBlastoiseBeaten {
    setflag(FLAG_HIDDEN_MEGA)
    clearflag(FLAG_CANT_CATCH_MON)
    removeobject(2)
    msgbox(format("The Blastoise retreats."))
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_MegaStoneGrotto_FaceUpPlayer)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    msgbox(format("You take the Mega Stone from the altar."))
    giveitem(ITEM_BLASTOISINITE)
    setflag(FLAG_BLASTOISE_MEGASTONE_FOUND)
}

//movement

script Movement_MegaStoneGrotto_PlayerSurpised {
    emote_exclamation_mark
    face_down
}

script Movement_BlastoiseArrives {
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
}

movement Movement_MegaStoneGrotto_FaceUpPlayer {
    face_up
}