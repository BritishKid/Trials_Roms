script MahoganyHills2_Trigger_RoxanneEncounter {
    lockall
    applymovement(7, Movement_MahoganyHills_RoxanneComingCloser)
    msgbox(format("Hi there, I've just been visiting Darwin to get new fossils. He has a little research station and has found the forest to be incredible for finding fossils."))
    msgbox(format("I'm visiting from Hoenn, and by that look, I can tell you're a trainer."))
    trainerbattle_single(TRAINER_ROXANNE_1, MahoganyHills_Roxanne_Battle_Intro, MahoganyHills_Roxanne_Battle_Outro, MahoganyHills_RoxanneBeaten)
    releaseall
}

script MahoganyHills_RoxanneBeaten {
    lockall
    msgbox(format("That's impressive. I'm not at my gym, but you should still take this."),MSGBOX_AUTOCLOSE)
    giveitem(ITEM_TM37)
    setflag(FLAG_RECEIVED_TM_ROCK_TOMB)
    msgbox(format("It's the TM for Rock Tomb, a great rock-type move that will slow your opponent down."),MSGBOX_AUTOCLOSE)
    setvar(VAR_ROXANNE_ENCOUNTER_STATE, 1)
    msgbox(format("I'll see you around again!"),MSGBOX_AUTOCLOSE)
    applymovement(OBJ_EVENT_ID_PLAYER, MahoganyHills1_MoveOutTheWay_Player)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(7, MahoganyHills1_RoxanneLeaves)
    waitmovement(7)
    removeobject(7)
    releaseall
}

script MahoganyHills2_EventScript_RoxanneEncounter { //Used if they speak to roxanne bypassing the trigger probably by surfing
    lockall
    faceplayer
    msgbox(format("Hi there, I've just been visiting Darwin to get new fossils. He has a little research station and has found the forest to be incredible for finding fossils."))
    msgbox(format("I'm visiting from Hoenn and by that look I can tell you're a trainer.") ,MSGBOX_AUTOCLOSE)
    trainerbattle_single(TRAINER_ROXANNE_1, MahoganyHills_Roxanne_Battle_Intro, MahoganyHills_Roxanne_Battle_Outro, MahoganyHills_RoxanneBeaten)
    
}

