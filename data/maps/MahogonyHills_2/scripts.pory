mapscripts MahogonyHills_2_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        if(var(VAR_MAHOGANYHILLS_BUTTONS_PRESSED) == 4) {
            setmetatile(36, 30, METATILE_Fortree_GroundHole, FALSE)
        }
    }
}


script MahoganyHills2_Trigger_BridgeRight {
    lockall
    msgbox(format("So you finally made it!"))
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_Platefallcave_Surprise)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(5, Movement_Rival_To_Player_MahoganyHills2Right)
    waitmovement(5)
    call(MahogonyHills2_EventScript_RivalEncounter)
    releaseall
}


script MahoganyHills2_Trigger_BridgeLeft {
    lockall
    msgbox(format("So you finally made it!"))
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_Platefallcave_Surprise)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(5, Movement_Rival_To_Player_MahoganyHills2Left)
    waitmovement(5)
    call(MahogonyHills2_EventScript_RivalEncounter)
    releaseall
}

script MahogonyHills2_EventScript_RivalEncounter {
    msgbox(format("I thought you would eventually get here, guess you had to come see my new badge.\lMy Pokémon barely broke a sweat beating the gym leader. In fact they got so much energy left they could still beat you!"))
    trainerbattle_single(TRAINER_RIVAL_MAHOGONYHILL2, MahoganyHills2_Rival_Intro, MahoganyHills2_Rival_Outro, MahoganyHills2_Rival_PostScript)
}

script MahoganyHills2_Rival_PostScript {
    setvar(VAR_BEDROCK_TOWN_STATE, 3)
    setflag(FLAG_MAHOGANY_HILLS_RIVAL_BEATEN)
    msgbox(format("You might have won but I still have more badges than you. That's what matters really."))
    //todo work out some prize for beating rival?? Ask viewers they are smarter than you Robert
    msgbox(format("Anyway I'm heading to get my next badge, I'll see you there if you don't lose too badly up here."))
    msgbox(format("See ya nerd!"))
    applymovement(5, Movement_Rival_Leaves_Player_MahoganyHills2)
    waitmovement(5)
    removeobject(5)
    releaseall
}

script MahoganyHills2_BattleScript_Luke {
    trainerbattle_single(TRAINER_LUKE_MAHOGANYHILLS2, MahoganyHills2_Luke_Intro, MahoganyHills2_Luke_Outro, Increase_Trainers_Beaten)
    msgbox(MahoganyHills2_Luke_Postbattle, MSGBOX_AUTOCLOSE)
}


script MahoganyHills2_Trigger_RoxanneEncounter {
    lockall
    applymovement(7, Movement_MahoganyHills_RoxanneComingCloser)
    msgbox(format("Hi there, I've just been visiting Darwin to get new fossils. He has a little research station and has found the forest to be incredible for finding fossils."))
    msgbox(format("I'm visiting from Hoenn and by that look I can tell you're a trainer."))
    trainerbattle_single(TRAINER_ROXANNE_1, MahoganyHills_Roxanne_Battle_Intro, MahoganyHills_Roxanne_Battle_Outro, MahoganyHills_RoxanneBeaten)
    releaseall
}

script MahoganyHills_RoxanneBeaten {
    lockall
    msgbox(format("That's impressive, I'm not at my gym but you should still take this."))
    giveitem(ITEM_TM37)
    playfanfare(MUS_OBTAIN_ITEM)
    setflag(FLAG_RECEIVED_TM_ROCK_TOMB)
    setvar(VAR_ROXANNE_ENCOUNTER_STATE, 1)
    msgbox(format("I'll see you around again!"))
    applymovement(OBJ_EVENT_ID_PLAYER, MahoganyHills1_MoveOutTheWay_Player)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(7, MahoganyHills1_RoxanneLeaves)
    waitmovement(7)
    removeobject(7)
    releaseall
}

script MahoganyHills2_EventScript_RoxanneEncounter { //Used if they speak to roxanne bypassing the trigger probably by surfing
    lockall
    faceplayer
    msgbox(format("Hi there, I've just been visiting Darwin to get new fossils. He has a little research station and has found the forest to be incredible for finding fossils."))
    msgbox(format("I'm visiting from Hoenn and by that look I can tell you're a trainer."))
    trainerbattle_single(TRAINER_ROXANNE_1, MahoganyHills_Roxanne_Battle_Intro, MahoganyHills_Roxanne_Battle_Outro, MahoganyHills_RoxanneBeaten)
    
}

script MahoganyHills_RoxanneBeaten_WithoutTrigger {
    lockall
    msgbox(format("That's impressive, I'm not at my gym but you should still take this."))
    giveitem(ITEM_TM37)
    playfanfare(MUS_OBTAIN_ITEM)
    setflag(FLAG_RECEIVED_TM_ROCK_TOMB)
    setvar(VAR_ROXANNE_ENCOUNTER_STATE, 1)
    msgbox(format("I'll see you around again!"))
    applymovement(OBJ_EVENT_ID_PLAYER, MahoganyHills1_MoveOutTheWay_Player_WithoutTrigger)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(7, Movement_MahoganyHills_RoxanneComingCloser)
    waitmovement(7)
    applymovement(7, MahoganyHills1_RoxanneLeaves)
    waitmovement(7)
    removeobject(7)
    releaseall
}


//Movement scripts
movement Movement_Rival_To_Player_MahoganyHills2Right {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
}

movement Movement_Rival_To_Player_MahoganyHills2Left {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
    walk_left
    face_down
}

movement Movement_Rival_Leaves_Player_MahoganyHills2 {
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
}

movement Movement_MahoganyHills_RoxanneComingCloser {
    walk_right
    walk_down
    walk_down
    walk_down
    walk_down
    walk_down
}

movement MahoganyHills1_MoveOutTheWay_Player {
    walk_down
    walk_right
    face_left
}

movement MahoganyHills1_RoxanneLeaves {
    walk_down
    walk_down
    walk_down
    walk_down
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
    walk_left
}

movement MahoganyHills1_MoveOutTheWay_Player_WithoutTrigger {
    walk_right
    walk_right
    face_left
}
