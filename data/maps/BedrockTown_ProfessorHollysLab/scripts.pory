mapscripts BedrockTown_ProfessorHollysLab_MapScripts {}


script BedrockTownLab_EventScript_ProfessorHolly {
    lockall
    faceplayer
    msgbox(format("Hi welcome to my lab. I'm Professor Holly. \p I'm currently putting together a team to do an expedition into the cave beneath the town."))
    if(flag(FLAG_BADGE04_GET)) {  
       msgbox(format("Oh well done you've managed to get 4 badges! Maybe you could assist me."))
       clearflag(FLAG_HIDE_BEDROCK_AIDE)
       setvar(VAR_LOST_LAKE_STATE, 1)
       msgbox(format("Head through that door and come help me on an my next research expedition."))
    } else {
        msgbox(format("Prove you're strong enough by getting 4 badges then you can assist me.")) //todo improve this to be less "gamey"
    }
    releaseall
}

script BedrockTownLab_EventScript_ProfessorAssistant {
    lockall
    faceplayer
    msgbox(format("Professor Holly is doing incredible research into the legendary Pokémon that created the lakes. As this one has dried out revealing a deep cavern it makes it the easiest place to research."))
    releaseall
}

script BedrockTownLab_EventScript_ExitAide {
    lockall
    if(var(VAR_LOST_LAKE_STATE) > 0) {
        msgbox(format("I heard Holly wanted your help in the lake, please join us down there."))
        applymovement(2, Movement_HollysLabAide_AwayFromExit)
        waitmovement(2)
        removeobject(2)
        }
    else {
        msgbox(format("You need Professor Holly's permission to go back here.")) 
    }
    releaseall
}

//movement
movement Movement_HollysLabAide_AwayFromExit {
    walk_up
}