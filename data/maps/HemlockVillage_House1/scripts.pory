mapscripts HemlockVillage_House1_MapScripts {
}

script HemlockVillage_House1_EventScript_BlackBelt {
    lockall
    faceplayer
    //todo is rock smashed
    if(!flag(FLAG_REMOVED_MOSSDEEP_ROCK)) {
        checkitem(ITEM_PICKAXE, 1)
        if(var(VAR_RESULT) == FALSE){
        msgbox(format("Have you see that guy outside trying to break rocks?"), MSGBOX_YESNO)
            if(var(VAR_RESULT) == NO) {
                msgbox(format("Oh nevermind then."))
            }
            if(var(VAR_RESULT) == YES) {
                msgbox(format("It's my brother, he thinks I can smash rocks with my fists but really I just use a tool."))
                msgbox(format("Why don't you take it and go mess with him."))
                giveitem(ITEM_PICKAXE, 1)
            }
        }
        if(var(VAR_RESULT) == TRUE) {
            msgbox(format("Smash that rock in front of him, he won't know what to do."))
        }
    }
    if(flag(FLAG_REMOVED_MOSSDEEP_ROCK)) {
        msgbox(format("You did it! I bet his face was a picture.\pPlease take this as a thanks."))
        giveitem(ITEM_TM53)
    }
    releaseall
}

script HemlockVillage_House1_EventScript_Woman {
    lockall
    faceplayer
    msgbox(format("I wish my Husband and his brother would grow up."))
    releaseall
}