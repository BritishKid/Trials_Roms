mapscripts BreakwaterPort_MegaTower_4F_MapScripts {}

script BreakwaterPort_MegaTower_4F_Trainer1 {
    trainerbattle_single(MEGATOWER4F_TRAINER1, Megatower4F_Trainer1_Intro, Megatower4F_Trainer1_Outro)
    msgbox(Megatower4F_Trainer1_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script BreakwaterPort_MegaTower_4F_Trainer2 {
    trainerbattle_single(MEGATOWER4F_TRAINER2, Megatower4F_Trainer2_Intro, Megatower4F_Trainer2_Outro)
    msgbox(Megatower4F_Trainer2_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script BreakwaterPort_MegaTower_4F_FloorAce {
    trainerbattle_single(MEGATOWER4F_TRAINERACE, Megatower4F_TrainerAce_Intro, Megatower4F_TrainerAce_Outro, Megatower4F_TrainerAce_Beaten)
    msgbox(Megatower4F_TrainerAce_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Megatower4F_TrainerAce_Beaten {
    msgbox(format("Well done you've made it through all four of us, but there is one more challenge left."), MSGBOX_DEFAULT)
    applymovement(2, Movement_MegaTower4_AceTrainerMovesAway)
    waitmovement(2)
    msgbox(format("Go on, head on through."))
}

//text

text Megatower4F_Trainer1_Intro {
    format("I hate sand, it's coarse and rough and gets everywhere.")
}

text Megatower4F_Trainer1_Outro {
    format("I hate battling, I'm poor and weak and always get beaten.")
}

text Megatower4F_Trainer1_PostBattle {
    format("...") //todo something better
}

text Megatower4F_Trainer2_Intro {
    format("It's amazing how they keep it warm all year round.")
}

text Megatower4F_Trainer2_Outro {
    format("Do you want to know how they do it?")
}

text Megatower4F_Trainer2_PostBattle {
    format("They pipe up the heat from the second floor to keep it warm in here.")
}

text Megatower4F_TrainerAce_Intro {
    format("I got here on skill, so don't let the look of my Pokemon fool you.")
}

text Megatower4F_TrainerAce_Outro {
    format("Woh I need a break.")
}

text Megatower4F_TrainerAce_PostBattle {
    format("Just head on through it's almost over.")
}

//movement 
movement Movement_MegaTower4_AceTrainerMovesAway {
    walk_right
    face_right
}

