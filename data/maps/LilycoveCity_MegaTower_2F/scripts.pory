mapscripts LilycoveCity_MegaTower_2F_MapScripts {}


script LilycoveCity_MegaTower_2F_Trainer1 {
    trainerbattle_single(MEGATOWER2F_TRAINER1, Megatower2F_Trainer1_Intro, Megatower2F_Trainer1_Outro)
    msgbox(Megatower2F_Trainer1_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script LilycoveCity_MegaTower_2F_Trainer2 {
    trainerbattle_single(MEGATOWER2F_TRAINER2, Megatower2F_Trainer2_Intro, Megatower2F_Trainer2_Outro)
    msgbox(Megatower2F_Trainer2_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script LilycoveCity_MegaTower_2F_FloorAce {
    trainerbattle_single(MEGATOWER2F_TRAINERACE, Megatower2F_TrainerAce_Intro, Megatower2F_TrainerAce_Outro, Megatower2F_TrainerAce_Beaten)
    msgbox(Megatower2F_TrainerAce_PostBattle, MSGBOX_AUTOCLOSE)
    end
}

script Megatower2F_TrainerAce_Beaten {
    msgbox(format("Mega Evolution can be incredibly painful on Pokemon, so a strong trust and skill is needed to bring out the best."), MSGBOX_DEFAULT)
    applymovement(3, Movement_MegaTower2_AceTrainerMovesAway)
    waitmovement(3)
    msgbox(format("Keep going you're half way now."))
}

//text

text Megatower2F_Trainer1_Intro {
    format("It's so hot in here, but my Pokemon thrive in it.")
}

text Megatower2F_Trainer1_Outro {
    format("How can you keep so cool.")
}

text Megatower2F_Trainer1_PostBattle {
    format("I need to take a break.")
}

text Megatower2F_Trainer2_Intro {
    format("How did they get the lava here?")
}

text Megatower2F_Trainer2_Outro {
    format("How does the lava not burn everything down?")
}

text Megatower2F_Trainer2_PostBattle {
    format("Why wont anyone tell me?")
}

text Megatower2F_TrainerAce_Intro {
    format("Congratulations for making it this far, but I'm sorry to say your journey ends here.")
}

text Megatower2F_TrainerAce_Outro {
    format("That doesn't happen very often.")
    }

text Megatower2F_TrainerAce_PostBattle {
    format("Keep it up, I look forward to our next battle.")
}

//movement 
movement Movement_MegaTower2_AceTrainerMovesAway {
    walk_left
    face_right
}