mapscripts FallHarbour_Harbour_MapScripts {}


script ThugCity_Harbour_EventScript_ThugCommander {
    lockall
    msgbox(format("No one is allowed to see the boss while he works."))
    trainerbattle_single(THUGCITY_COMMANDER, ThugCommander_Intro, ThugCommander_Outro, ThugCommander_PostScript)
    releaseall
}

script ThugCommander_PostScript {
    msgbox(format("Boss has finished his work so we got all the information we need."), MSGBOX_AUTOCLOSE)
    applymovement(OBJ_EVENT_ID_PLAYER, Movement_PlayerOutWay_Harbour_ThugCity)
    waitmovement(OBJ_EVENT_ID_PLAYER)
    applymovement(1, Movement_CommanderLeaves)
    applymovement(2, Movement_BossToPlayer)
    waitmovement(1)
    msgbox(format("Next time we won't be so nice."), MSGBOX_AUTOCLOSE)
    applymovement(2, Movement_CommanderLeaves)
    waitmovement(2)
    setflag(FLAG_HIDE_ALL_THUG_CITY_THUGS)
    clearflag(FLAG_HIDE_THUG_CITY_OVERWORLD_INHABITANTS)
    removeobject(1)
    removeobject(2)
    releaseall
}

script ThugCity_Island2Boat {
    lockall
    faceplayer
    msgbox(format("Would you like to travel to Island 1?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == YES) {
        warp(MAP_CORAL_PORT_HARBOR, 8, 11)
    }
    releaseall
}

//text

text ThugCommander_Intro {
    format("Persistent one huh, fine let me show you how this will happen.")
}

text ThugCommander_Outro {
    format("It doesn't matter you're too late.")
}

//movement

movement Movement_PlayerOutWay_Harbour_ThugCity {
    jump_right
}

movement Movement_CommanderLeaves {
    walk_fast_down
    walk_fast_down
    walk_fast_down
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
    walk_fast_right
}

movement Movement_BossToPlayer {
    walk_left
    walk_down
    walk_down
    walk_down
    face_right
}