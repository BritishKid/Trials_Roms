mapscripts MahoganyHills_GymEntrance_MapScripts {}


script MahoganyHills1_GymEntrance_Trigger_RobEncounter {
    lockall
    clearflag(FLAG_HIDE_FIRST_ENCOUNTER_ROB)
    setvar(VAR_ROBERT_STATUS, 1)
    setobjectxy(1, 17, 21)
    applymovement(1, Movement_Robert_Gym1_TowardsPlayer)
    waitmovement(1)
    msgbox(format("I've been hearing all about a tough trainer, could it be you?"))
    if(var(VAR_TRAINERS_BEATEN_CHECK) > 8) {
        msgbox(format("Yes you fit the desription."))
        call(MahoganyHills1_GymEntrance_Robert_Battle)
    }
    else {
        msgbox(format("But you don't fit the description."))
        applymovement(1, Movement_Robert_Gym1_ResetPosition)
    }
    releaseall
}

script MahoganyHills1_GymEntrance_EventScript_RobertSpoke {
    lockall
    faceplayer
    if(var(VAR_ROBERT_STATUS) == 2) {
        msgbox(format("I can't wait to battle you again when we are stronger."))
    }
    if(var(VAR_TRAINERS_BEATEN_CHECK) > 8 && var(VAR_ROBERT_STATUS) < 2) {
        msgbox(format("I've been hearing alot about you."))
        call(MahoganyHills1_GymEntrance_Robert_Battle)
    }
    if(var(VAR_TRAINERS_BEATEN_CHECK) < 8 && var(VAR_ROBERT_STATUS) < 2) {
        msgbox(format("Can I help you with something?"))
    }
    releaseall
}

script MahoganyHills1_GymEntrance_Robert_Battle {
    trainerbattle_single(TRAINER_ROBERT_MAHOGANYHILLSGYM, MahoganyHills_Robert_Intro, MahoganyHills_Robert_Outro, MahoganyHills_Robert_Postbattle)
}

script MahoganyHills_Robert_Postbattle {
    msgbox(format("That was an incredible battle, you are stronger than people say."))
    msgbox(format("Why don't you take this, it will be very helpful."))
    giveitem(ITEM_ABILITY_PATCH, 1)
    msgbox(format("You can use it on a Pokemon to unlock their hidden ability."))
    setvar(VAR_ROBERT_STATUS, 2)
    setflag(FLAG_HIDE_FIRST_ENCOUNTER_ROB)
}

script MahoganyHills1_GymEntrance_EventScript_GymSign {
    lockall
    msgbox(format("Mahogany Hills Gym - Leader Jaiden"))
    releaseall
}

//text 
text MahoganyHills_Robert_Intro {
    format("This will be an exciting battle!")
}

text MahoganyHills_Robert_Outro {
    format("The rumours where wrong,\l you're much stronger.")
}

//movement
movement Movement_Robert_Gym1_TowardsPlayer {
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
    walk_up
}

movement Movement_Robert_Gym1_ResetPosition {
    walk_right
    walk_right
    face_down
}