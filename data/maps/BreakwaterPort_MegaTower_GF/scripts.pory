mapscripts BreakwaterPort_MegaTower_GF_MapScripts {
    MAP_SCRIPT_ON_TRANSITION {
        //reset all batttles to make repeatable
        cleartrainerflag(MEGATOWER1F_TRAINER1)
        cleartrainerflag(MEGATOWER1F_TRAINER2)
        cleartrainerflag(MEGATOWER1F_TRAINERACE)
        cleartrainerflag(MEGATOWER2F_TRAINER1)
        cleartrainerflag(MEGATOWER2F_TRAINER2)
        cleartrainerflag(MEGATOWER2F_TRAINERACE)
        cleartrainerflag(MEGATOWER3F_TRAINER1)
        cleartrainerflag(MEGATOWER3F_TRAINER2)
        cleartrainerflag(MEGATOWER3F_TRAINERACE)
        cleartrainerflag(MEGATOWER4F_TRAINER1)
        cleartrainerflag(MEGATOWER4F_TRAINER2)
        cleartrainerflag(MEGATOWER4F_TRAINERACE)
        cleartrainerflag(MEGATOWER5F_TRAINERACE1)
        cleartrainerflag(MEGATOWER5F_TRAINERACE2)
        cleartrainerflag(MEGATOWER5F_TRAINERACE3)
        cleartrainerflag(MEGATOWER5F_TRAINERACE4)
        cleartrainerflag(MEGATOWER5F_TRAINEREXPERT)
        setflag(FLAG_HIDE_EXPERT_MEGATOWER)
    }
}

script MegaTower_EventScript_OldMindy {
    lockall
    faceplayer
    if(flag(FLAG_MEGATOWER_NPC_TRADE_COMPLETED)) {
        goto(MegaTower_OldMindy_TradeComplete)
    }
    setvar(VAR_0x8008, INGAME_TRADE_HAUNTER)
    copyvar(VAR_0x8004, VAR_0x8008)
    specialvar(VAR_RESULT, GetInGameTradeSpeciesInfo)
    copyvar(VAR_0x8009, VAR_RESULT)
    msgbox(format("Do you have a {STR_VAR_1}, I'll trade it for my {STR_VAR_2}?"), MSGBOX_YESNO)
    if(var(VAR_RESULT) == NO) {
        goto(MegaTower_TradeDeclined)
    }
    if(var(VAR_RESULT) == YES) {
        special(ChoosePartyMon)
        waitstate
        copyvar(VAR_0x800A, VAR_0x8004)
        if(var(VAR_0x8004) == PARTY_NOTHING_CHOSEN) {
            goto(MegaTower_TradeDeclined)
        }
        copyvar(VAR_0x8005, VAR_0x800A)
        specialvar(VAR_RESULT, GetTradeSpecies)
        copyvar(VAR_0x800B, VAR_RESULT)
        if(var(VAR_RESULT) != VAR_0x8009) {
            msgbox(format("That's not a {STR_VAR_1}."))
        }
        copyvar(VAR_0x8004, VAR_0x8008)
        copyvar(VAR_0x8005, VAR_0x800A)
        special(CreateInGameTradePokemon)
        special(DoInGameTradeScene)
        waitstate
        msgbox(format("Have you noticed {STR_VAR_2} didn't evolve? In TRIVER some Pokemon don't evolve through trade but instead from a special item. Check it out it will be holding that item."))    
        setflag(FLAG_MEGATOWER_NPC_TRADE_COMPLETED)
    }
    releaseall
}

script MegaTower_TradeDeclined {
    msgbox(format("That's a shame..."))
    releaseall
}

script MegaTower_OldMindy_TradeComplete {
    msgbox(format("I have a sister in Sinnoh, but I haven't heard much from her lately."))
}

script MegaTower_CoolTrainer_M {
    lockall
    faceplayer
    msgbox(format("That old lady is from Sinnoh, and she keeps trying to give me a Haunter."))
    releaseall
}

script MegaTower_CoolTrainer_F {
    lockall
    faceplayer
    msgbox(format("My boyfriend and I keep training but not many places in Triver allow for double battles."))
    releaseall
}

script MegaTower_BugTrainer {
    lockall
    faceplayer
    msgbox(format("I put a seed in here every day and nothing has grown all year..."))
    releaseall
}

script MegaTower_SeedPot {
    lockall
    msgbox(format("It's a pot full of seeds but no dirt"))
    if(!flag(FLAG_RECEIVED_MIRACLE_SEED)) {
        msgbox(format("Take one?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            giveitem(ITEM_MIRACLE_SEED)
            setflag(FLAG_RECEIVED_MIRACLE_SEED)
        }
    }
    releaseall
}

script MegaTower_FirstTimeTrigger {
    lockall
    applymovement(5, MegaTower_GreeterShock)
    waitmovement(5)
    call(MegaTower_FirstTime_Explained)
    releaseall
}

script MegaTower_Greeter {
    lockall
    faceplayer
    if(var(VAR_MEGATOWER_STATE) > 1) {
        msgbox(format("Remember once you start, you have to beat the challenge in one go."))
    }
    if(var(VAR_MEGATOWER_STATE) == 1) {
        call(MegaTower_FirstTime_Explained)
    }
    releaseall
}

script MegaTower_FirstTime_Explained {
    msgbox(format("Hey Champ! Welcome to the Mega Tower."))
    msgbox(format("You're about to take on a gauntlet of strong trainer, each one the master of their own domain. It's no easy feat."))
    msgbox(format("Once you enter you will have to beat it in one go, you can leave at any time but you'll be sent back here to try again."))
    msgbox(format("Most trainers don't make it through all four floors, so best of luck!"))
    setvar(VAR_MEGATOWER_STATE, 2)
    releaseall
}

script MegaTower_NoticeBoard {
    lockall
    msgbox(format("It's a list of everyone who's ever beaten the Mega Tower.")) //todo add some members
    releaseall
}
//movement

movement MegaTower_GreeterShock {
    emote_exclamation_mark
    face_right
}