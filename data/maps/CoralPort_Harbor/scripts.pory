mapscripts CoralPort_Harbor_MapScripts {

}

script Island1_TravelByBoat {
    lockall
    if(flag(FLAG_RECEIVED_SS_TICKET)) {    
        msgbox(format("Would you like to travel to Island 2?"), MSGBOX_YESNO)
        if(var(VAR_RESULT) == YES) {
            if(!flag(FLAG_HIDE_BLOCKER_THUGS)) {
                msgbox(format("Due to trouble in the Islands Port we will have to drop you on the beach for your safety."))
                warp(MAP_ROUTE5, 24, 6)
            }
            if(flag(FLAG_HIDE_BLOCKER_THUGS)) {
                warp(MAP_FALL_HARBOUR_HARBOUR, 8, 11)
            }
        }
    }
    if(!flag(FLAG_RECEIVED_SS_TICKET)) {
        msgbox(format("You need to have a ticket if you wish to travel on this boat."))
    }
    releaseall
}